# Server Configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=3001

# Supabase / PostgreSQL Database
# Use transaction pooler URL (port 6543) or direct connection URL (port 5432)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Supabase Storage (Persistent Uploads for Render Free)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key
SUPABASE_STORAGE_BUCKET=mimios-assets

# Local Database Fallback (Only used for offline/legacy dev without PostgreSQL)
DATABASE_PATH=./data/mimios.db

# Admin Credentials
ADMIN_EMAIL=admin@mimios.local
ADMIN_PASSWORD=replace-with-a-long-random-password-min-12-chars

# Session Secret (at least 32 characters)
SESSION_SECRET=replace-with-at-least-32-random-characters-for-session-signing
# Cookie Cross-Origin Settings (Defaults to 'none' and 'true' in production for cross-origin HTTPS)
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# CORS (Comma-separated origins for production & local dev)
CORS_ORIGIN=http://localhost:5173,https://mimios.onrender.com

# Uploads
UPLOAD_MAX_SIZE=52428800
UPLOAD_DIR=./uploads

# GitHub API (Optional: increases rate limit from 60 to 5000 requests/hr)
GITHUB_TOKEN=
GITHUB_USERNAME=pratyushrobert

# NVIDIA NIM AI Inference (MimiAI Cyber Ninja Cat)
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
