# Server Configuration
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Database
DATABASE_PATH=./data/mimios.db

# Admin credentials (set these in your actual, uncommitted .env file)
ADMIN_EMAIL=admin@mimios.local
ADMIN_PASSWORD=replace-with-a-long-random-password

# Session
SESSION_SECRET=replace-with-at-least-32-random-characters

# CORS
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_MAX_SIZE=52428800
UPLOAD_DIR=./uploads

# GitHub API (Optional: increases rate limit from 60 to 5000 requests/hr)
GITHUB_TOKEN=
GITHUB_USERNAME=pratyushrobert
